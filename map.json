  "centre": {
    "question": [
      {
        "date": "2026-10-18",
        "text": "Generative test-fit tools win projects through fast, iterative proposals at concept stage. Can the same iterative, rule-based process — and the information models it produces — carry on into design development and construction documents?"
      }
    ],
    "hypothesis": [
      {
        "date": "2026-10-18",
        "text": "Rule-based generation produces information models — geometry with data — that can be iterated and carried from concept into production, not only sketched at concept stage."
      }
    ]
  },
